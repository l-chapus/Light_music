        private void HomeForm_Load(object sender, EventArgs e)
        {
            // Place the open button centered within the panelContent
            CenterOpenButton();
            this.panelContent.Controls.Add(btnOpenMain);
        }

        private void CenterOpenButton()
        {
            btnOpenMain.Location = new Point((this.panelContent.ClientSize.Width - btnOpenMain.Width) / 2,
                                             (this.panelContent.ClientSize.Height - btnOpenMain.Height) / 2);
            btnOpenMain.Anchor = AnchorStyles.None;
        }

        private void btnOpenMain_Click(object sender, EventArgs e)
        {
            // Hide home button and show back button
            btnOpenMain.Visible = false;
            btnBack.Visible = true;

            // Create Form1 and embed it inside panelContent
            if (embeddedMain == null)
            {
                embeddedMain = new Form1();
                embeddedMain.TopLevel = false;
                embeddedMain.FormBorderStyle = FormBorderStyle.None;
                embeddedMain.Dock = DockStyle.Fill;
                this.panelContent.Controls.Add(embeddedMain);
                embeddedMain.Show();
            }
        }

        private void btnBack_Click(object sender, EventArgs e)
        {
            // Remove the embedded main form and show the home button again
            if (embeddedMain != null)
            {
                try
                {
                    embeddedMain.Close();
                    embeddedMain.Dispose();
                }
                catch { }
                this.panelContent.Controls.Remove(embeddedMain);
                embeddedMain = null;
            }

            btnBack.Visible = false;
            btnOpenMain.Visible = true;
            CenterOpenButton();
        }

        private void btnAddElement_Click(object sender, EventArgs e)
        {
            // Remove the embedded main form and show the home button again
            if (embeddedMain != null)
